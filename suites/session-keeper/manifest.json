{
  "name": "session-keeper",
  "version": "0.2.0",
  "description": "会话体验守护套件：当前提供标题自动维护（UserPromptSubmit hook 每轮提醒 + 技能判断漂移并改写，支持 ONES 单号前缀），后续会话状态等能力可并入同一套件。",
  "type": "suite",
  "mappings": [
    {
      "source": "skills/session-keeper/SKILL.md",
      "target": "{HOME}/.claude/skills/session-keeper/"
    },
    {
      "source": "hooks/session-keeper.js",
      "target": "{HOME}/.claude/hooks/"
    }
  ]
}
