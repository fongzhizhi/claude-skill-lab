{
  "name": "git-flow",
  "version": "0.1.0",
  "description": "Git 环境分支工作流套件：/git-flow-start、/git-flow-sync、/git-flow-commit、/git-flow-merge 四个命令与共享核心技能，覆盖任务分支创建、环境同步、格式化提交与 MR 冲突预检。",
  "type": "suite",
  "mappings": [
    {
      "source": "commands/*.md",
      "target": "{HOME}/.claude/commands/"
    },
    {
      "source": "skills/git-flow-core/SKILL.md",
      "target": "{HOME}/.claude/skills/git-flow-core/"
    },
    {
      "source": "docs/git-flow-config.md",
      "target": "{HOME}/.claude/docs/"
    }
  ]
}
