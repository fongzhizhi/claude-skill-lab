{
  "dependencies": [
    {
      "name": "git（>= 2.38，/git-flow-merge 的 merge-tree 预检）",
      "check": "git --version",
      "required": true
    },
    {
      "name": "glab（GitLab CLI；内网 GitLab 需 glab auth login --hostname <内网域名> 或设置 GITLAB_HOST）",
      "check": "glab --version",
      "install": "winget install glab.glab",
      "required": false
    }
  ]
}
