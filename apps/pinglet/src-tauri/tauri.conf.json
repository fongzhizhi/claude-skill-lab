{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pinglet",
  "version": "1.3.0",
  "identifier": "com.fongzhizhi.pinglet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pinglet",
        "width": 280,
        "height": 320,
        "minWidth": 280,
        "maxWidth": 600,
        "minHeight": 200,
        "maxHeight": 800,
        "resizable": true,
        "maximizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
